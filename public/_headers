# Response headers on Cloudflare (Workers Static Assets, see wrangler.jsonc).
# expo-sqlite on web needs SharedArrayBuffer, which needs cross-origin isolation.
# require-corp (not credentialless) because Safari on iPhone only supports require-corp;
# the only cross-origin files (Tesseract on cdn.jsdelivr.net) send CORS and CORP headers.
/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer

# File names contain a content hash, so they never change.
/_expo/static/*
  Cache-Control: public, max-age=31536000, immutable

/sw.js
  Cache-Control: no-cache
